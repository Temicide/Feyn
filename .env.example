# MongoDB connection string. Unset locally to keep records in memory; required on Vercel.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
# Database name inside MONGODB_URI. Defaults to feyn.
MONGODB_DB=feyn
# Random string of at least 32 characters that signs session cookies. Required on Vercel.
SESSION_SECRET=replace-with-a-long-random-string
# Google OAuth web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google OAuth web client secret.
GOOGLE_CLIENT_SECRET=your-client-secret
# Public origin of the app. Google redirects to APP_ORIGIN/api/auth/callback. Required on Vercel.
APP_ORIGIN=http://127.0.0.1:5173
# Comma-separated Google account emails that get the teacher role.
TEACHER_EMAILS=teacher@example.com
# 1 enables /api/auth/dev local test accounts. Ignored on Vercel.
DEV_LOGIN=1
# Bearer token MCP clients send to /mcp. Unset turns the endpoint off.
MCP_TOKEN=replace-with-a-long-random-token
# ElevenLabs key for Scribe v2 speech recognition.
ELEVENLABS_API_KEY=your-elevenlabs-key
# Anthropic-compatible Messages API base URL. A loopback host is labeled Local AI gateway.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Key for the assessment endpoint.
ANTHROPIC_API_KEY=your-anthropic-key
# Model name the assessment endpoint accepts.
ANTHROPIC_MODEL=your-model
# U-Bot account email for server-side recap drafts.
UBOT_EMAIL=you@example.com
# U-Bot account password.
UBOT_PASSWORD=your-ubot-password
# Supabase anonymous key U-Bot's sign-in uses.
UBOT_SUPABASE_ANON_KEY=your-ubot-anon-key
