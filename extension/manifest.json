{
  "manifest_version": 3,
  "name": "Feyn bridge for U-Bot",
  "version": "0.1.0",
  "description": "Lets U-Bot call the read-only tools of a Feyn app running on this computer.",
  "host_permissions": ["http://127.0.0.1:4173/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://u.bot/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
